                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.eqtechnologic.eqube.mi</groupId>
            <artifactId>deviceconnector-connection-service</artifactId>
