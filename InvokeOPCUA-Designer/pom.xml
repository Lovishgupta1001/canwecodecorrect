        <dependency>
            <groupId>com.eqtechnologic.eqube.platform.transport</groupId>
            <artifactId>Transport-UIService</artifactId>
            <classifier>signed</classifier>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.eqtechnologic.eqube.platform.process</groupId>
            <artifactId>activitymanagement-service-common</artifactId>
            <classifier>${jarClassifier}</classifier>
            <exclusions>
                <exclusion>
