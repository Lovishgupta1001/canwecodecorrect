        <dependency>
            <groupId>com.eqtechnologic.eqube.adminconsole</groupId>
            <artifactId>componentframework-service</artifactId>
            <version>${adminconsole.version}</version>
            <classifier>${jarClassifier}</classifier>
            <exclusions>
                <exclusion>
